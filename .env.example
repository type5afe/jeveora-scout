# Copy to .env and fill in. Everything except the API key has a sensible default.

# Jev. Without a key the scout still runs, but "Entry Now" comes from simple rules instead of Jev.
TYPESAFE_API_KEY=
# Pin a model version so answers don't shift under you when TypeSafe ships a new one.
# TYPESAFE_DEFAULT_MODEL=jev-1.13.0

# Your wallet's PUBLIC address, to show your open DLMM positions. Never put a private key here.
WALLET=

# Discord alerts. Channel -> Edit Channel -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL.
# Keep it secret: anyone with this URL can post to your channel. Test it with: npm run test-discord
DISCORD_WEBHOOK_URL=
# Which alerts go to Discord (default: all of them).
# DISCORD_ALERTS=opportunity,entry,out_of_range,rebalance,exit

# Timezone for the times on screen. A VPS usually runs on UTC. Example: TZ=Asia/Jakarta
# TZ=

# How often to scan pools, and how often to re-ask Jev about the same pool.
SCAN_INTERVAL_SEC=60
JEV_INTERVAL_SEC=180

# Which pools count as an opportunity at all (hard filters, checked in code before Jev sees anything).
VENUES=dlmm,dammv2
QUOTES=SOL,USDC
# Rank pools by fees vs TVL over 1h, 4h or 24h. 1h mostly finds tokens that are pumping right now.
RANK_WINDOW=4h
MIN_TVL_USD=10000
MIN_VOLUME_1H_USD=20000
MIN_FEE_TVL_1H_PCT=0.2
MIN_POOL_AGE_MIN=30
MIN_HOLDERS=300
MAX_TOP_HOLDERS_PCT=30
MAX_WATCHING=10

# When "Entry Opportunity" becomes "Entry Now".
MIN_CONFIDENCE=0.7
MAX_RUG=0.3

# Don't repeat the same alert for a pool within this window.
ALERT_COOLDOWN_MIN=30
